@using PlanetSimulator.Rendering
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>PlanetSimulator — interactieve demo</PageTitle>
<div class="shell">
    <header>
        <a class="brand" href="./"><span class="brand-mark">◉</span> PlanetSimulator</a>
        <span class="milestone">MILESTONE 6 <span>·</span> BROWSERDEMO</span>
    </header>
    <main>
        <div class="world-column">
        <section class="viewer" aria-label="Interactieve planeet">
            <div class="viewer-heading"><span class="eyebrow">EEN WERELD IN WORDING</span><h1>Een wereld die vorm krijgt.</h1></div>
            <canvas id="planet-canvas" @ref="canvas" aria-label="3D-planeet: sleep om te draaien en scroll om te zoomen" tabindex="0"></canvas>
            <div class="viewer-bottom"><span class="status-dot"></span><span>@(session.Clock.IsPaused ? "Gepauzeerd" : "Simulatie actief")</span><span class="mouse-hint">Slepen om te draaien · scrollen om te zoomen</span></div>
            @if (error is not null)
            {
                <div class="error" role="alert">@error</div>
            }
        </section>
        <section class="energy-panel" aria-label="Energiebalans">
            <div class="energy-header"><span class="eyebrow">GEMIDDELD OVER DE HELE PLANEET</span><span id="thermal-trend" class="trend">@ThermalTrend</span></div>
            <div class="energy-row"><span>Opgenomen zonlicht</span><strong id="absorbed-flux">@F(snapshot.AbsorbedWattsPerSquareMeter, "F1") W/m²</strong></div>
            <div class="energy-track"><div class="incoming" style="width:@FluxWidth(snapshot.AbsorbedWattsPerSquareMeter)%"></div></div>
            <div class="energy-row"><span>Uitgestraalde warmte</span><strong id="emitted-flux">@F(snapshot.EmittedWattsPerSquareMeter, "F1") W/m²</strong></div>
            <div class="energy-track"><div class="outgoing" style="width:@FluxWidth(snapshot.EmittedWattsPerSquareMeter)%"></div></div>
            <div class="energy-summary"><span>Netto energiestroom</span><strong id="net-flux">@F(snapshot.NetWattsPerSquareMeter, "+0.0;-0.0;0.0") W/m²</strong></div>
            <p>Positieve energie warmt op of smelt ijs. Negatieve energie koelt af of bevriest water. Warmtecapaciteit en faseovergangen bepalen het tempo.</p>
        </section>
        </div>
        <aside>
            <span class="eyebrow">REFERENTIEPLANEET</span>
            <h2>Van evenaar tot pool.</h2>
            <p class="intro">Verander de afstand tot de ster of de reflectie en ontdek hoe de planeet naar een nieuw temperatuurevenwicht beweegt.</p>
            <label for="climate-model">Klimaatmodel (wisselen herstart de tijd)</label>
            <select id="climate-model" value="@(session.Regional is null ? "global" : session.Regional.Surface is null ? "regional" : "surface")" @onchange="SelectModel" disabled="@(!ready)">
                <option value="surface">Land, water en ijs · planeetweergave</option><option value="regional">Regionaal · 288 cellen</option><option value="global">Uniform · milestone 2</option>
            </select>
            <div class="temperature-card"><span>GEMIDDELDE MODELTEMPERATUUR</span>
                <strong id="temperature" data-kelvin="@F(snapshot.TemperatureKelvin, "F6")">@F(snapshot.TemperatureKelvin - 273.15) <small>°C</small></strong>
                <div><span>@F(snapshot.TemperatureKelvin) K</span><span>Stralingseq.: <b id="equilibrium-temperature" data-kelvin="@F(snapshot.EquilibriumTemperatureKelvin, "F6")">@F(snapshot.EquilibriumTemperatureKelvin - 273.15) °C</b></span></div>
            </div>
            @if (snapshot.Regional is { } regional)
            {
                <div class="regional-summary" id="regional-summary" data-cells="@regional.TemperaturesKelvin.Count">
                    <div><span>Koudste / warmste cel</span><strong><b id="regional-min" data-kelvin="@F(regional.MinimumTemperatureKelvin, "F6")">@F(regional.MinimumTemperatureKelvin - 273.15)</b> / <b id="regional-max" data-kelvin="@F(regional.MaximumTemperatureKelvin, "F6")">@F(regional.MaximumTemperatureKelvin - 273.15)</b> °C</strong></div>
                    <div><span>Noord / zuid gemiddeld</span><strong>@F(regional.NorthMeanTemperatureKelvin - 273.15) / @F(regional.SouthMeanTemperatureKelvin - 273.15) °C</strong></div>
                    <div><span>Zonnedeclinatie</span><strong id="solar-declination">@F(regional.SolarDeclinationRadians * 180 / Math.PI)°</strong></div>
                    <div><span>Energiebudgetafwijking</span><strong id="regional-budget">@F(regional.BudgetErrorJoulesPerSquareMeter, "G3") J/m²</strong></div>
                </div>
            }
            @if (snapshot.Regional?.Surface is { } water)
            {
                <div class="regional-summary" id="surface-summary" data-liquid-fraction="@F(water.LiquidMassFraction, "R")">
                    <div><span>Waterbedekking</span><strong>@F(water.WaterCoveredFraction * 100)%</strong></div>
                    <div><span>Vloeibaar / ijs (massa)</span><strong>@F(water.LiquidMassFraction * 100)% / @F((1 - water.LiquidMassFraction) * 100)%</strong></div>
                    <div><span>Totale watermassa</span><strong>@F(water.TotalWaterMassKilograms, "G4") kg</strong></div>
                    <div><span>Waterbudgetafwijking</span><strong id="water-budget">@F(water.WaterMassErrorKilograms, "G3") kg</strong></div>
                </div>
                <div class="appearance-controls">
                    <span class="eyebrow">PLANEETWEERGAVE</span>
                    <div class="controls"><button id="cold-start" class="secondary" @onclick="() => RestartSurface(230)">IJswereld · 230 K</button>
                        <button id="warm-start" class="secondary" @onclick="() => RestartSurface(285)">Waterwereld · 285 K</button></div>
                    <p class="field-hint">Een startwereld kiezen herstart de tijd. Water kan daarna afkoelen, bevriezen of smelten door de berekende energiebalans.</p>
                    <label class="checkbox"><input id="atmosphere" type="checkbox" @bind="atmosphere" @bind:after="ChangeAtmosphereAsync" /> Atmosferische gloed (visueel)</label>
                    <label for="visual-relief">Zichtbaar reliëf <strong>@F(relief * 100, "F0")%</strong></label>
                    <input id="visual-relief" class="regional-range" type="range" min="0" max="1" step="0.1" @bind="relief" @bind:event="oninput" @bind:after="ChangeReliefAsync" />
                    <p class="field-hint">Terrein en kustlijn volgen de hoogtefunctie; richels en kleuren zijn visueel detail. Reliëf is uitvergroot. De gloed verandert het klimaat niet.</p>
                </div>
            }
            <div class="time-card"><span>VERSTREKEN SIMULATIETIJD</span><strong id="elapsed-days">@((session.Clock.ElapsedSeconds / 86400).ToString("F3", System.Globalization.CultureInfo.InvariantCulture)) <small>dagen</small></strong></div>
            <div class="controls">
                <button id="pause" @onclick="TogglePause" disabled="@(!ready)">@(session.Clock.IsPaused ? "▶ Hervatten" : "Ⅱ Pauzeren")</button>
                <button id="reset" class="secondary" @onclick="ResetAsync" disabled="@(!ready)">↺ Reset</button>
            </div>
            <label for="speed">Tijdsnelheid</label>
            <select id="speed" value="@session.Clock.Speed" @onchange="ChangeSpeed" disabled="@(!ready)">
                <option value="1">Realtime · 1×</option>
                <option value="3600">1 uur per seconde · 3.600×</option>
                <option value="86400">1 dag per seconde · 86.400×</option>
                <option value="604800" disabled="@(session.Regional is not null)">1 week per seconde · 604.800×</option>
            </select>
            <label class="checkbox"><input id="wireframe" type="checkbox" @bind="wireframe" @bind:after="ChangeWireframeAsync" disabled="@(!ready)" /> Toon het geometrische rooster</label>
            @if (session.Regional is not null)
            {
                <label class="checkbox"><input id="temperature-map" type="checkbox" @bind="temperatureMap" @bind:after="ChangeTemperatureMapAsync" /> Temperatuurkaart op de planeet</label>
                <div class="heat-legend"><div></div><span>170 K (−103 °C)</span><span>330 K (57 °C)</span></div>
                <p class="field-hint">Vaste kleurschaal; waarden buiten dit bereik krijgen de eindkleur. Cellen hebben gelijke oppervlaktes. De kaart toont temperatuur, ook aan de nachtzijde.</p>
                <label for="axial-tilt">Ashelling <strong>@F(session.Regional.Parameters.AxialTiltDegrees)°</strong></label>
                <input id="axial-tilt" class="regional-range" type="range" min="0" max="90" step="1" value="@F(session.Regional.Parameters.AxialTiltDegrees)" @oninput="ChangeTilt" />
                <label for="heat-diffusion">Warmtetransport <strong>@F(session.Regional.Parameters.HeatDiffusionWattsPerSquareMeterKelvin) W/m²/K</strong></label>
                <input id="heat-diffusion" class="regional-range" type="range" min="0" max="2" step="0.1" value="@F(session.Regional.Parameters.HeatDiffusionWattsPerSquareMeterKelvin)" @oninput="ChangeDiffusion" />
            }
            <div class="forcing-controls">
                <label for="star-distance">Afstand tot de ster <strong>@F(session.Climate.Parameters.DistanceAstronomicalUnits) AU</strong></label>
                <input id="star-distance" type="range" min="0.5" max="2" step="0.05" value="@F(session.Climate.Parameters.DistanceAstronomicalUnits)" @oninput="ChangeDistance" disabled="@(!ready)" />
                <label for="albedo">Reflectie (Bond-albedo) <strong>@F(session.Climate.Parameters.BondAlbedo * 100, "F0")%</strong></label>
                <input id="albedo" type="range" min="0" max="0.8" step="0.01" value="@F(session.Climate.Parameters.BondAlbedo)" @oninput="ChangeAlbedo" disabled="@(!ready)" />
                <p>AU = afstand aarde–zon. Reset herstart op @F(session.Climate.Parameters.InitialTemperatureKelvin, "F0") K met je huidige instellingen.</p>
            </div>
            <dl><div><dt>Straal</dt><dd>6.371 km</dd></div><div><dt>Zwaartekracht</dt><dd>@session.Planet.SurfaceGravity.ToString("F2") m/s²</dd></div><div><dt>Rotatieperiode</dt><dd>24 uur</dd></div><div><dt>Substraatcapaciteit</dt><dd>10 MJ/m²/K</dd></div></dl>
            <div class="note"><strong>Een bewust eenvoudig model</strong><p>Regionale stralingsbalans en benaderd warmtetransport, zonder atmosfeer of broeikaseffect. Geen aardse klimaatvoorspelling. De temperatuurkaart volgt modeldata; in het watermodel toont de oppervlaktekaart land, water en ijs. Faseovergangen veronderstellen vaste druk; atmosfeer, verdamping en afvoer volgen later. Reflectie blijft uniform.</p></div>
        </aside>
        <ExperimentPanel />
    </main>
    <footer><span>Van eenvoudige bol naar een bewoonbare wereld.</span><span id="build-version">Milestone 6</span></footer>
</div>

@code {
    private SimulationSession session = new(regional: new RegionalParameters(), surface: new SurfaceParameters());
    private SimulationSnapshot snapshot = new(0, 0, 230, 254.578, 238.175, 158.7);
    private bool temperatureMap;
    private bool atmosphere = true;
    private double relief = 1;
    private static string F(double value, string format = "F2") => value.ToString(format, System.Globalization.CultureInfo.InvariantCulture);
    private string ThermalTrend => Math.Abs(snapshot.NetWattsPerSquareMeter) < 0.1 ? "Bijna in evenwicht"
        : snapshot.NetWattsPerSquareMeter > 0 ? "Warmt op" : "Koelt af";

    private string FluxWidth(double flux) => F(100 * flux / Math.Max(1, Math.Max(snapshot.AbsorbedWattsPerSquareMeter, snapshot.EmittedWattsPerSquareMeter)));
    private readonly CancellationTokenSource lifetime = new();
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<PlanetDemo>? reference;
    private bool ready;
    private bool wireframe;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        session.Clock.Speed = 86400;
        snapshot = session.Snapshot();
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token, "./js/planet.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("start", lifetime.Token, canvas, reference, Appearance());
            ready = true;
        }
        catch (JSException exception)
        {
            error = exception.Message.Contains("WebGL", StringComparison.OrdinalIgnoreCase)
                ? "Deze browser kan de 3D-planeet niet tekenen. Gebruik een browser met WebGL 2 en ingeschakelde hardwareversnelling."
                : "De demo kon niet starten. Vernieuw de pagina om opnieuw te proberen.";
        }

        StateHasChanged();
    }

    [JSInvokable]
    public SimulationSnapshot Advance(double realSeconds)
    {
        snapshot = session.Advance(realSeconds, lifetime.Token);
        StateHasChanged();
        return snapshot;
    }

    private void TogglePause() => session.Clock.IsPaused = !session.Clock.IsPaused;

    private void ChangeSpeed(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var speed)) session.Clock.Speed = speed;
    }

    private async Task ResetAsync()
    {
        session.Reset(lifetime.Token);
        snapshot = session.Snapshot();
        if (module is not null) await module.InvokeVoidAsync("resetCamera", lifetime.Token);
    }

    private void ChangeDistance(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var distance))
        {
            session.SetForcing(distance, session.Climate.Parameters.BondAlbedo, lifetime.Token);
            snapshot = session.Snapshot();
        }
    }

    private void ChangeAlbedo(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var albedo))
        {
            session.SetForcing(session.Climate.Parameters.DistanceAstronomicalUnits, albedo, lifetime.Token);
            snapshot = session.Snapshot();
        }
    }

    private async Task SelectModel(ChangeEventArgs args)
    {
        var choice = args.Value?.ToString();
        session.SelectModel(choice is "regional" or "surface" ? new RegionalParameters() : null, lifetime.Token);
        if (choice == "surface") session.SelectSurface(new SurfaceParameters(), lifetime.Token);
        temperatureMap = choice == "regional";
        if (module is not null)
        {
            await module.InvokeVoidAsync("setSurfaceGeometry", lifetime.Token, Appearance());
            await ChangeTemperatureMapAsync();
        }
        if (session.Regional is not null) session.Clock.Speed = Math.Min(session.Clock.Speed, 86400);
        snapshot = session.Snapshot();
    }
    private void ChangeTilt(ChangeEventArgs args)
    {
        if (session.Regional is { } model && double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var value))
            model.SetParameters(new RegionalParameters(value, model.Parameters.HeatDiffusionWattsPerSquareMeterKelvin, model.Parameters.YearDays), lifetime.Token);
        snapshot = session.Snapshot();
    }
    private void ChangeDiffusion(ChangeEventArgs args)
    {
        if (session.Regional is { } model && double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var value))
            model.SetParameters(new RegionalParameters(model.Parameters.AxialTiltDegrees, value, model.Parameters.YearDays), lifetime.Token);
        snapshot = session.Snapshot();
    }
    private SurfaceGeometryData? Appearance() => session.Regional?.Surface is { } surface
        ? new SurfaceAppearance(surface, lifetime.Token).Export() : null;

    private void RestartSurface(double kelvin)
    {
        var climate = session.Climate.Parameters;
        var paused = session.Clock.IsPaused; var speed = session.Clock.Speed;
        session = new SimulationSession(new ClimateParameters(climate.DistanceAstronomicalUnits, climate.BondAlbedo,
            climate.ArealHeatCapacity, kelvin, climate.StellarLuminositySolarUnits), session.Regional?.Parameters ?? new RegionalParameters(), new SurfaceParameters());
        session.Clock.IsPaused = paused; session.Clock.Speed = Math.Min(speed, 86400);
        snapshot = session.Snapshot();
    }
    private async Task ChangeAtmosphereAsync()
    {
        if (module is not null) await module.InvokeVoidAsync("setAtmosphere", lifetime.Token, atmosphere);
    }
    private async Task ChangeReliefAsync()
    {
        if (module is not null) await module.InvokeVoidAsync("setRelief", lifetime.Token, relief);
    }
    private async Task ChangeTemperatureMapAsync()
    {
        if (module is not null) await module.InvokeVoidAsync("setTemperatureMap", lifetime.Token, temperatureMap);
    }
    private async Task ChangeWireframeAsync()
    {
        if (module is not null) await module.InvokeVoidAsync("setWireframe", lifetime.Token, wireframe);
    }

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("stop", CancellationToken.None);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page has already closed.
            }
        }

        reference?.Dispose();
        lifetime.Dispose();
    }
}
